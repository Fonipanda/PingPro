# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=pingpro

# AnythingLLM Configuration (optionnel - fonctionne sans)
# Pour activer AnythingLLM:
# 1. Lancez Docker Desktop
# 2. docker-compose up -d
# 3. Accédez à http://localhost:3001
# 4. Créez un workspace nommé "pingpro"
# 5. Générez une API key dans Settings
ANYTHINGLLM_API_URL=http://localhost:3001/api
ANYTHINGLLM_API_KEY=your-api-key-here
ANYTHINGLLM_WORKSPACE=pingpro
